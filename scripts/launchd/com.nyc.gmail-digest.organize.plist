<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  gmail-daily-digest V3 - hourly organize pass (launchd).

  Replaces the old crontab line "0 * * * * ...".

  WHY launchd: macOS cron does NOT fire while the Mac is asleep and never
  replays a missed slot. launchd with StartCalendarInterval runs the missed
  calendar slot ONCE on wake, closing the sleep gap that killed the 07h report.

  Install: copy to ~/Library/LaunchAgents/ then `launchctl load -w`.
  See scripts/launchd/README.md for the full procedure.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nyc.gmail-digest.organize</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nycolasvieira/repos/gmail-daily-digest/scripts/run-organizer.sh</string>
    </array>

    <!-- Top of every hour. launchd replays this once after wake if missed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do not run on load/login; only on the calendar schedule. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nycolasvieira/.local/logs/gmail-daily-digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nycolasvieira/.local/logs/gmail-daily-digest.log</string>

    <!-- Docker Desktop CLI lives outside launchd's default PATH; the wrapper
         re-exports PATH too, but set a sane baseline here as well. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
